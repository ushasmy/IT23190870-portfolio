{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/content.json",
      "dest": "/content.json"
    },
    {
      "src": "/bg_frames/(.*)",
      "dest": "/bg_frames/$1"
    },
    {
      "src": "/project_pics/(.*)",
      "dest": "/project_pics/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
